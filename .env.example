# --- TMDB (https://www.themoviedb.org/settings/api) ---
TMDB_API_KEY=tu_api_key_de_tmdb
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_LANGUAGE=es-MX
TMDB_IMAGE_BASE=https://image.tmdb.org/t/p/w500

# --- PostgreSQL (Neon / Supabase / local). Las tablas se crean solas al arrancar ---
# En servicios cloud agrega ?sslmode=require
DATABASE_URL=postgresql://usuario:password@localhost:5432/nexflis

# --- Secretos (genera valores largos y aleatorios) ---
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# FLASK_SECRET_KEY: sesion + llave AES (Fernet). JWT_SECRET: JWT + firmas HMAC.
FLASK_SECRET_KEY=cambia_este_secret_en_local
JWT_SECRET=cambia_este_jwt_secret_en_local

# --- Solo produccion ---
# 'development' (default) | 'production' -> cookie Secure, secretos obligatorios, ProxyFix
# FLASK_ENV=production
# Saltos de proxy delante de Flask (Netlify -> Render = 2). Ver docs/DESPLIEGUE.md
# PROXY_HOPS=2
